WEAVRIA_MODEL_BASE_URL=https://api.deepseek.com
WEAVRIA_MODEL_NAME=deepseek-flash
WEAVRIA_MODEL_API_KEY=
WEAVRIA_MODEL_JSON_MODE=true
WEAVRIA_MODEL_MAX_OUTPUT_TOKENS=4096
WEAVRIA_UNDERSTANDING_MAX_OUTPUT_TOKENS=8192
WEAVRIA_UNDERSTANDING_REASONING_EFFORT=none
WEAVRIA_UNDERSTANDING_MAX_DURATION_SECONDS=180
WEAVRIA_CONTEXT_WINDOW_TOKENS=32768
WEAVRIA_CONTEXT_ENCODING=cl100k_base
WEAVRIA_RUN_MAX_MODEL_CALLS=20
WEAVRIA_RUN_MAX_TOOL_CALLS=20
WEAVRIA_RUN_MAX_REQUEST_BYTES=64000
WEAVRIA_RUN_MAX_DURATION_SECONDS=180
WEAVRIA_FINSCOPE_BASE_URL=http://127.0.0.1:8080
WEAVRIA_ALLOWED_PARENT_ORIGIN=http://localhost:5173
WEAVRIA_STATE_PATH=.weavria/finscope-sessions.sqlite3

# 预算内收尾预留。0 保留现有基线；设置 2 启用生成与修复机会。
WEAVRIA_FINALIZATION_MODEL_CALLS=0
WEAVRIA_FINALIZATION_SECONDS=10
